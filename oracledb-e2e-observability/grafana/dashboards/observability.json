          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 41,
      "title": "Failed connection acquisitions",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "description": "Failed UCP acquisitions per second. A healthy idle or lightly loaded pool reports zero after initialization.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ucp_connections_acquire_failed_milliseconds_count{service_name=\"oracledb-e2e-observability\"}[$__rate_interval]))",
          "legendFormat": "Failed acquisitions",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
