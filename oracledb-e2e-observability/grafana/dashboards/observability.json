            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Connection acquisition \u00b7 mean and peak",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "description": "UCP-reported mean and peak acquisition time. Function timers do not contain a latency distribution, so p95 is not calculated for UCP.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ucp_connections_acquire_average_milliseconds{service_name=\"oracledb-e2e-observability\"}",
          "legendFormat": "Mean",
          "range": true,
          "interval": "10s"
        },
        {
          "refId": "B",
          "expr": "ucp_connections_acquire_peak_milliseconds{service_name=\"oracledb-e2e-observability\"}",
          "legendFormat": "Peak",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "decimals": 2,
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 40,
      "title": "Pool utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "description": "Used connections as a share of maximum pool capacity.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(db_client_connection_count_connections{service_name=\"oracledb-e2e-observability\",db_client_connection_state=\"used\"}) / (sum(db_client_connection_max_connections{service_name=\"oracledb-e2e-observability\"}) > 0)",
          "legendFormat": "Used capacity",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
