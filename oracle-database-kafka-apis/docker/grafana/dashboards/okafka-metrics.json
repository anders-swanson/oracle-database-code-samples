{
  "uid": "okafka-metrics-sample",
  "title": "OKafka Metrics Sample",
  "description": "Native OKafka producer transaction, consumer, and Actuator metrics for the Oracle AI Database sample.",
  "tags": [
    "okafka",
    "oracle-ai-database",
    "sample"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service name",
        "type": "textbox",
        "query": "okafka-metrics-sample",
        "current": {
          "text": "okafka-metrics-sample",
          "value": "okafka-metrics-sample"
        },
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Producer commit time",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cumulative time spent in the producer's commitTransaction calls, as reported by OKafka. This measures API call time, not the number of committed or aborted records.",
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_producer_txn_commit_time_ns_total{service_name=\"$service\",client_id=\"metrics-producer\"})",
          "legendFormat": "Commit time",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Producer abort time",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cumulative time spent in the producer's abortTransaction calls, as reported by OKafka. This measures API call time, not the number of committed or aborted records.",
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_producer_txn_abort_time_ns_total{service_name=\"$service\",client_id=\"metrics-producer\"})",
          "legendFormat": "Abort time",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Consumer fetches",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Native consumer fetch count, including records fetched again after rollback. Client and topic series are deduplicated. This is not a count of committed SQL updates.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max without (topic) (kafka_consumer_fetch_manager_records_consumed_total{service_name=\"$service\",client_id=\"metrics-consumer\"}))",
          "legendFormat": "Fetched",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Seconds since poll",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "A rising value indicates that the consumer is no longer polling.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kafka_consumer_last_poll_seconds_ago{service_name=\"$service\",client_id=\"metrics-consumer\"})",
          "legendFormat": "Last poll",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Consumer fetch throughput",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Native consumer fetch rate. The continuous workload targets two records per second. Rollback and redelivery can temporarily increase the fetch rate.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max without (topic) (rate(kafka_consumer_fetch_manager_records_consumed_total{service_name=\"$service\",client_id=\"metrics-consumer\"}[$__rate_interval])))",
          "legendFormat": "Fetched / second",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "interval": "10s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    },
    {
      "id": 6,
      "title": "Producer transaction time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cumulative time in beginTransaction, commitTransaction, and abortTransaction, reported directly by OKafka. These counters reset when the client restarts.",
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_producer_txn_begin_time_ns_total{service_name=\"$service\",client_id=\"metrics-producer\"})",
          "legendFormat": "Begin time",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "interval": "10s"
        },
        {
          "refId": "B",
          "expr": "sum(kafka_producer_txn_commit_time_ns_total{service_name=\"$service\",client_id=\"metrics-producer\"})",
          "legendFormat": "Commit time",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "interval": "10s"
        },
        {
          "refId": "C",
          "expr": "sum(kafka_producer_txn_abort_time_ns_total{service_name=\"$service\",client_id=\"metrics-producer\"})",
          "legendFormat": "Abort time",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "interval": "10s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    },
    {
      "id": 7,
      "title": "JVM memory used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Memory used across JVM pools, grouped into heap and nonheap.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (area) (jvm_memory_used_bytes{service_name=\"$service\"})",
          "legendFormat": "{{area}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "interval": "10s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    },
    {
      "id": 8,
      "title": "Application CPU usage",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "CPU usage reported by the JVM, from zero to one.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{service_name=\"$service\"}",
          "legendFormat": "CPU",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "range": true,
          "instant": false,
          "interval": "10s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "10s"
    }
  ]
}
