map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name _;
    location = /health {
        access_log off;
        return 200 'ready\n';
    }
    # Publish only the public trust anchor for database startup.
    location = /lab-ca.crt {
        alias /lab-ca/ca.crt;
    }
    location / {
        return 308 https://$host:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Resolve Compose service names again after upstream containers are recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $grafana http://grafana-lgtm:3000;
    set $exporter http://exporter:9161;
    set $otlp http://grafana-lgtm:4318;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    location = /metrics {
        proxy_pass $exporter$request_uri;
    }
    location ~ ^/v1/(metrics|logs|traces)$ {
        client_max_body_size 10m;
        proxy_pass $otlp$request_uri;
    }
    location / {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass $grafana$request_uri;
    }
}
