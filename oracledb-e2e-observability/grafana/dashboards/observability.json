    {
      "id": 9,
      "title": "Connection borrows and returns",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 7
      },
      "description": "Connections borrowed and returned per second. Sustained divergence alongside rising utilization can indicate connections being held.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ucp_connections_borrowed_total{service_name=\"oracledb-e2e-observability\"}[$__rate_interval]))",
          "legendFormat": "Borrowed",
          "range": true,
          "interval": "10s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ucp_connections_returned_total{service_name=\"oracledb-e2e-observability\"}[$__rate_interval]))",
          "legendFormat": "Returned",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "decimals": 2,
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
