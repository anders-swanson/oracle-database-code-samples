{
  "uid": "oracledb-e2e",
  "title": "Oracle AI Database end-to-end observability",
  "description": "Follow HTTP requests through UCP and JDBC, compare pool and database activity, and correlate application logs with request traces.",
  "tags": [
    "oracle-ai-database",
    "observability",
    "spring-boot",
    "ucp"
  ],
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "panels": [
    {
      "id": 10,
      "title": "Follow a request from HTTP to Oracle AI Database",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "description": "",
      "options": {
        "mode": "markdown",
        "content": "**Spring Boot \u2192 UCP \u2192 Oracle JDBC \u2192 Oracle AI Database**\n\nRun `sh workload.sh` in the sample directory. Watch the panels below, then copy a response trace ID into **Request traces**. Allow about one minute after the first request for rate panels to appear. Server-side tracing is configured; database server spans are not yet working on ARM."
      }
    },
    {
      "id": 11,
      "title": "Database status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "description": "Exporter connectivity to FREEPDB1. Missing telemetry is shown separately from a failed connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(oracledb_up{service_name=\"oracledb_exporter\",database=\"freepdb1\"})",
          "legendFormat": "FREEPDB1",
          "range": true,
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "noValue": "No telemetry",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No telemetry",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 12,
      "title": "Requests / sec",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "description": "Traffic handled by GET /api/readings.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_milliseconds_count{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval]))",
          "legendFormat": "Requests",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "noValue": "No telemetry",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No telemetry",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 13,
      "title": "Avg latency",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "description": "Mean HTTP latency across readings requests. Includes pool acquisition and SQL execution.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_milliseconds_sum{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval])) / (sum(rate(http_server_requests_milliseconds_count{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval])) > 0)",
          "legendFormat": "Response time",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "decimals": 2,
          "noValue": "No telemetry",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No telemetry",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 14,
      "title": "Error rate",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "description": "Share of readings requests returning HTTP 4xx or 5xx. Returns zero when requests exist without errors; missing telemetry stays empty.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_requests_milliseconds_count{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\",status=~\"4..|5..\"}[$__rate_interval])) or 0 * sum(rate(http_server_requests_milliseconds_count{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval]))) / (sum(rate(http_server_requests_milliseconds_count{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval])) > 0)",
          "legendFormat": "Errors",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "noValue": "No telemetry",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "max": 100,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No telemetry",
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 20,
      "title": "1 \u00b7 HTTP traffic and response time",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "description": "",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "title": "Requests by HTTP status",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "description": "Each response status gets its own series. Send an invalid X-Client-Id to demonstrate a 400 response.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_milliseconds_count{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "HTTP latency \u00b7 mean and p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "description": "Mean and estimated p95 for GET /api/readings. p95 uses explicit finite HTTP histogram buckets; restart Java after changing bucket configuration.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_milliseconds_sum{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval])) / (sum(rate(http_server_requests_milliseconds_count{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval])) > 0)",
          "legendFormat": "Mean",
          "range": true,
          "interval": "10s"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_milliseconds_bucket{service_name=\"oracledb-e2e-observability\",uri=\"/api/readings\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "decimals": 2,
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 21,
      "title": "2 \u00b7 UCP connections and pressure",
      "type": "row",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "description": "",
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "title": "Connections and pool capacity",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "description": "Used and idle UCP connections alongside maximum configured capacity. This is physical connection inventory, not the number of queries executed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_client_connection_state) (db_client_connection_count_connections{service_name=\"oracledb-e2e-observability\"})",
          "legendFormat": "{{db_client_connection_state}}",
          "range": true,
          "interval": "10s"
        },
        {
          "refId": "B",
          "expr": "sum(db_client_connection_max_connections{service_name=\"oracledb-e2e-observability\"})",
          "legendFormat": "Maximum capacity",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "No telemetry",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Requests waiting for a connection",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 18,
        "w": 8,
        "h": 7
      },
      "description": "A sustained queue indicates demand exceeding available pool connections.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(db_client_connection_pending_requests{service_name=\"oracledb-e2e-observability\"})",
          "legendFormat": "Waiting requests",
          "range": true,
          "interval": "10s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
